{
	"name": "meetlens",
	// Lambda の Python ランタイムに合わせて 3.13 を使う（バージョンは Dockerfile で指定）
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		// Vite 7 は Node 20.19+ / 22.12+ が必要
		"ghcr.io/devcontainers/features/node:1": { "version": "22" },
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/terraform:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// SAM Local がホストの Docker でコンテナを起動するため
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},
	"mounts": [
		// git push 用。ホスト（WSL）の SSH 鍵を読み取り専用で使う
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
		// Claude Code のログイン情報・設定をコンテナ作り直し後も残す
		"source=meetlens-claude-config,target=/home/vscode/.claude,type=volume",
		// Codex のログイン情報・設定を残す
		"source=meetlens-codex-config,target=/home/vscode/.codex,type=volume",
		// gh のログイン情報を残す
		"source=meetlens-gh-config,target=/home/vscode/.config/gh,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"forwardPorts": [5173, 3000],
	"portsAttributes": {
		"5173": { "label": "Vite (frontend)" },
		"3000": { "label": "SAM Local API" }
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"Vue.volar",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"hashicorp.terraform",
				"amazonwebservices.aws-toolkit-vscode"
			],
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python"
			}
		}
	}
}
